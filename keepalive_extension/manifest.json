{
  "manifest_version": 3,
  "name": "IIT KGP ERP Session Helper",
  "version": "1.0.0",
  "description": "Open IIT KGP ERP and keep an existing browser session alive.",
  "permissions": ["alarms", "tabs", "cookies", "clipboardRead"],
  "host_permissions": ["https://erp.iitkgp.ac.in/*"],
  "action": {
    "default_title": "IIT KGP ERP",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service_worker.js"
  }
}
